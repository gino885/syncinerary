# Database
DATABASE_URL=postgresql+asyncpg://syncinerary:syncinerary@localhost:5432/syncinerary
REDIS_URL=redis://localhost:6379/0
# Persistent private directory for user-submitted screenshots. Production
# hosts with ephemeral filesystems need an object-storage implementation.
ATTACHMENT_UPLOAD_DIR=.data/attachments
# Trust only the production reverse proxy addresses. The local default is
# loopback; do not use a wildcard for an internet-facing service.
FORWARDED_ALLOW_IPS=127.0.0.1

# Anthropic
# Production trips use the trip creator's encrypted key, entered in the app.
# Keep ANTHROPIC_API_KEY empty in production. It is only a local or legacy fallback.
ANTHROPIC_API_KEY=
# Generate a 32-byte key, base64-url encode it, then store the JSON value in
# the cloud provider's secret manager. Never commit a real value here. Keep
# old numbered keys during rotation until all credentials have been rewrapped.
SYNC_CREDENTIAL_ENCRYPTION_KEYS={"1":"replace-with-urlsafe-base64-32-byte-key"}
SYNC_CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=1

# Models
SYNC_LLM_MODEL=claude-opus-4-7
SYNC_CHEAP_MODEL=claude-haiku-4-5

# Observability
PHOENIX_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=syncinerary
# Keep prompts and responses out of production traces. A developer may opt in
# only on a private local Phoenix instance with synthetic or approved data.
SYNC_TRACE_SENSITIVE_CONTENT=false

# Harness (used from M2 onwards)
SYNC_MAX_STEPS=50
SYNC_MAX_TOKENS_USD=2.0
# Defaults match Claude Opus 4.7 standard API pricing. Override these when
# SYNC_LLM_MODEL uses a different price tier.
SYNC_LLM_INPUT_USD_PER_MILLION=5
SYNC_LLM_OUTPUT_USD_PER_MILLION=25

# External tool APIs
GOOGLE_MAPS_API_KEY=
BRAVE_SEARCH_API_KEY=
# The primary transit provider. Everything after it is a fallback asked only
# about the arcs it could not route, never a parallel query.
# Use transitous only for light, open-source, non-commercial prototype testing.
SYNC_TRANSIT_PROVIDER=google
# Ordered, comma separated. A provider with no credentials is dropped from the
# chain rather than failing, so the pipeline runs on a Google key alone and
# degrades to primary then conservative estimate exactly as it did before.
SYNC_TRANSIT_FALLBACK_PROVIDERS=here
# Optional. A HERE freemium "REST API key" from https://platform.here.com,
# with the Public Transit product enabled. Leave blank to run without HERE.
HERE_API_KEY=

# Password recovery only. Signup does not send an email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SECURITY=tls for implicit TLS (usually port 465).
# plain is accepted only for a localhost test inbox, never a remote server.

# Optional native Google and Apple sign-in. See docs/SOCIAL_SIGN_IN.md.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
