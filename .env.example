# Database
DATABASE_URL=postgresql+asyncpg://syncinerary:syncinerary@localhost:5432/syncinerary
REDIS_URL=redis://localhost:6379/0

# Anthropic (not strictly needed for M0, used from M1+)
ANTHROPIC_API_KEY=sk-ant-...

# Models
SYNC_LLM_MODEL=claude-opus-4-7
SYNC_CHEAP_MODEL=claude-haiku-4-5

# Observability
PHOENIX_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=syncinerary

# Harness (used from M2 onwards)
SYNC_MAX_STEPS=50
SYNC_MAX_TOKENS_USD=2.0
# Defaults match Claude Opus 4.7 standard API pricing. Override these when
# SYNC_LLM_MODEL uses a different price tier.
SYNC_LLM_INPUT_USD_PER_MILLION=5
SYNC_LLM_OUTPUT_USD_PER_MILLION=25

# External tool APIs
GOOGLE_MAPS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
