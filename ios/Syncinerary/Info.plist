<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.local.syncinerary.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>syncinerary</string>
				<string>$(SYNC_GOOGLE_CALLBACK_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>SyncAppleSignInEnabled</key>
	<string>$(SYNC_APPLE_SIGN_IN_ENABLED)</string>
	<key>CFBundleDisplayName</key>
	<string>Syncinerary</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>SyncAPIBaseURL</key>
	<string>$(SYNC_API_BASE_URL)</string>
	<key>SyncPrivacyPolicyURL</key>
	<string>$(SYNC_PRIVACY_POLICY_URL)</string>
	<key>SyncSupportURL</key>
	<string>$(SYNC_SUPPORT_URL)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the trip planning server on your local network.</string>
	<key>UIAppFonts</key>
	<array>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
