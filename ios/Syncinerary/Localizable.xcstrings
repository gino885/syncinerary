          }
        }
      }
    },
    "Allow Syncinerary to send trip cities, preferences, shared links, votes, and instructions to Anthropic to create recommendations and itineraries.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Syncinerary 將旅行城市、偏好、分享連結、投票與指示傳送給 Anthropic，用於推薦地點及規劃行程。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Syncinerary 将旅行城市、偏好、分享链接、投票与指示发送给 Anthropic，用于推荐地点及规划行程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめや旅程を作成するため、旅行先の都市、好み、共有リンク、投票、指示を Syncinerary から Anthropic に送信することを許可します。"
          }
        }
      }
    },
    "Trips you create use your Anthropic account and may incur Anthropic API charges. The key is encrypted on the server and the full value is never shown again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你建立的行程會使用你的 Anthropic 帳戶，可能產生 API 費用。金鑰會加密儲存在伺服器，儲存後不再顯示完整內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你创建的行程会使用你的 Anthropic 账户，可能产生 API 费用。密钥会加密保存在服务器，保存后不再显示完整内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成した旅行ではあなたの Anthropic アカウントを使用し、API 料金が発生する場合があります。キーはサーバーに暗号化して保存され、完全な値は再表示されません。"
          }
        }
      }
    },
