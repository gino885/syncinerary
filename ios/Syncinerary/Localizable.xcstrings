          }
        }
      }
    },
    "This key looks incomplete. Paste the complete Anthropic API key.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰長度不正確，請貼上完整的 Anthropic API 金鑰。"
          }
        },
