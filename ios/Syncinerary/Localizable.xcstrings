    },
    "The key contains a space or line break. Paste the complete key again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰中間含有空白或換行，請重新貼上完整金鑰。"
          }
        },
